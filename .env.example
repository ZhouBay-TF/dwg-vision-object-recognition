# Never commit real keys. The key pasted in chat should be revoked and replaced.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp
# Some OpenCode environments call the DeepSeek key simply `deepseek`.
# The explicit DEEPSEEK_API_KEY name above is preferred.
# deepseek=
# Optional shared model alias; explicit VISION/FUSION names are preferred.
# DEEPSEEK_MODEL=

ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# Use an Ark vision-understanding model here. Seedream is an image-generation
# model and is intentionally rejected by the JSON detection adapter.
ARK_VISION_MODEL=doubao-seed-evolving
# Recommended Ark image transport: upload the local prepared image through
# Files API, then reference file_id in Responses API. Set chat_base64 only
# when troubleshooting an endpoint that does not expose Responses.
ARK_VISION_TRANSPORT=responses_file
ARK_FILE_PURPOSE=user_data
# Keep the visual answer bounded; the short auditable notes are intentional.
VISION_MAX_OUTPUT_TOKENS=4096
# Ark visual reasoning is optional. Enable only when the model deployment
# supports the thinking field and the added latency/cost is acceptable.
ARK_VISION_THINKING=disabled
# Compatible aliases accepted by the Ark adapter when ARK_* is not set.
# ANTHROPIC_AUTH_TOKEN=
# ANTHROPIC_BASE_URL=https://ark.cn-beijing.volces.com/api/compatible
# ANTHROPIC_MODEL=
# The current local .env may also use this legacy custom key name:
# huoshanfnagzhou=
# Optional image generation/editing model for future visual enhancement only.
ARK_IMAGE_MODEL=doubao-seedream-5-0-pro-260628

# SymPointV2 cloud API. In production this is normally the local endpoint of
# an SSH tunnel, for example http://127.0.0.1:18000.
SYMPOINT_BASE_URL=http://127.0.0.1:8000

# Optional Scene Graph evidence fusion; it cannot modify CAD geometry or
# override direct native equipment labels.
DEEPSEEK_FUSION_MODEL=deepseek-v4-pro
# DeepSeek reasoning is used only to improve the final structured decision;
# reasoning_content is never written to detection.json or trace artifacts.
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_THINKING=enabled

# Per-request timeout for Ark/DeepSeek calls. Failed calls are recorded and
# the bounded pipeline continues with the remaining evidence.
VISION_REQUEST_TIMEOUT_S=120
# Maximum pixel dimension sent to a vision model. Original CAD renders are
# retained unchanged for comparison artifacts.
VISION_MAX_IMAGE_DIM=1600

# Optional local AutoCAD ActiveX override. Leave empty to auto-detect 2020-2027.
AUTOCAD_PROG_ID=
# Seconds to wait while AutoCAD is starting, loading a DWG, or dismissing UI.
AUTOCAD_COM_TIMEOUT_S=180
